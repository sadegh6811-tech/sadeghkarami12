"""تشخیص فرکانس با فیلتر هوش مصنوعی ریاضی‌دان."""
import numpy as np
from math_ai_core import filter_frequencies


def detect_circle_pairs(X, rtol=0.15):
    n, d = X.shape
    pairs = {}
    used = set()
    for i in range(d):
        for j in range(i + 1, d):
            if i in used or j in used:
                continue
            # چک ستون ثابت
            if X[:, i].std() < 1e-6 or X[:, j].std() < 1e-6:
                continue
            r2 = X[:, i] ** 2 + X[:, j] ** 2
            mean_r2 = r2.mean()
            if mean_r2 < 1e-6 or mean_r2 > 1e6:
                continue
            if r2.std() / mean_r2 < rtol:
                pairs[(i, j)] = float(mean_r2)
                used.add(i)
                used.add(j)
    return pairs


def detect_dominant_frequencies(x, y, n_freqs=2, n_omega=2000,
                                 min_omega=0.5, max_omega=20.0,
                                 r2_threshold=0.85):
    """اسکن شبکه‌ای ω — کاندیدهای فرکانس (فیلتر نهایی با AI)."""
    x = np.asarray(x, dtype=float)
    y = np.asarray(y, dtype=float)
    n = len(x)
    if n < 40 or y.std() < 1e-12:
        return []
    yn = (y - y.mean()) / y.std()

    omegas = np.linspace(min_omega, max_omega, n_omega)
    r2_scores = np.zeros(n_omega)
    ones = np.ones(n)

    for k, omega in enumerate(omegas):
        s = np.sin(omega * x)
        c = np.cos(omega * x)
        A = np.column_stack([s, c, ones])
        try:
            coef, _, rank, _ = np.linalg.lstsq(A, yn, rcond=None)
        except Exception:
            continue
        if rank < 3:
            continue
        pred = A @ coef
        ss_res = np.sum((yn - pred) ** 2)
        ss_tot = np.sum(yn ** 2)
        if ss_tot > 1e-12:
            r2_scores[k] = 1.0 - ss_res / ss_tot

    peaks = []
    work = r2_scores.copy()
    for _ in range(n_freqs):
        k = int(np.argmax(work))
        if work[k] < r2_threshold:
            break
        omega_best = omegas[k]
        if 0 < k < n_omega - 1:
            y0, y1, y2 = work[k - 1], work[k], work[k + 1]
            denom = y0 - 2 * y1 + y2
            delta = 0.5 * (y0 - y2) / denom if abs(denom) > 1e-12 else 0.0
            omega_best = omegas[k] + delta * (omegas[1] - omegas[0])
        if omega_best > 0:
            if not any(abs(omega_best - p) / max(p, 1e-9) < 0.05 for p in peaks):
                peaks.append(float(omega_best))
        lo = max(0, k - 10)
        hi = min(len(work), k + 11)
        work[lo:hi] = 0.0

    return peaks


def detect_all_frequencies(X, top_n=2, verbose=False):
    """تشخیص فرکانس + فیلتر با AI."""
    n, d = X.shape
    all_freqs = {j: [] for j in range(d)}
    circles = detect_circle_pairs(X)
    circle_vars = set()
    for (i, j) in circles:
        circle_vars.add(i)
        circle_vars.add(j)
    for v in circle_vars:
        all_freqs[v] = []

    for i in range(d):
        if i in circle_vars:
            continue
        for j in range(d):
            if i == j:
                continue
            candidates = detect_dominant_frequencies(X[:, i], X[:, j], n_freqs=top_n)
            if not candidates:
                continue
            # فیلتر با AI
            approved = filter_frequencies(
                X[:, i], X[:, j], candidates, X, i, j, threshold=0.5
            )
            if verbose:
                print(f"    x{i} vs x{j}: candidates={[f'{c:.3f}' for c in candidates]} -> approved={[f'{a:.3f}' for a in approved]}")
            for f in approved:
                if not any(abs(f - g) / max(g, 1e-9) < 0.05 for g in all_freqs[i]):
                    all_freqs[i].append(f)

    for j in all_freqs:
        all_freqs[j].sort()
    return all_freqs, circles
