"""کتابخانه‌ی توابع نمایی، لگاریتمی، کسری — نسخه‌ی اصلاح‌شده."""
import numpy as np


def exp_library(X):
    """فقط exp و exp(-x) — با نرمال‌سازی مقیاس."""
    n, d = X.shape
    cols, specs = [], []
    for i in range(d):
        # نرمال‌سازی داخلی برای جلوگیری از اشباع
        xi = X[:, i]
        std = xi.std()
        if std < 1e-10:
            xi_norm = np.zeros(n)
        else:
            xi_norm = (xi - xi.mean()) / std
        xi_clip = np.clip(xi_norm, -3, 3)  # محدودتر برای جلوگیری از اشباع
        cols.append(np.exp(xi_clip)); specs.append(("exp", i, 0.0))
        cols.append(np.exp(-xi_clip)); specs.append(("expm", i, 0.0))
    return np.column_stack(cols), specs


def log_library(X, offset=0.1):
    """فقط log — با clip برای جلوگیری از مقادیر منفی."""
    n, d = X.shape
    cols, specs = [], []
    for i in range(d):
        xi = np.abs(X[:, i]) + offset
        cols.append(np.log(xi)); specs.append(("log", i, 0.0))
    return np.column_stack(cols), specs


def inverse_library(X, offset=0.1):
    """فقط 1/x — با clip."""
    n, d = X.shape
    cols, specs = [], []
    for i in range(d):
        xi = np.where(np.abs(X[:, i]) < offset, offset, X[:, i])
        cols.append(1.0 / xi); specs.append(("inv", i, 0.0))
    return np.column_stack(cols), specs


def hyperbolic_library(X):
    """فقط tanh — با نرمال‌سازی مقیاس."""
    n, d = X.shape
    cols, specs = [], []
    for i in range(d):
        xi = X[:, i]
        std = xi.std()
        if std < 1e-10:
            xi_norm = np.zeros(n)
        else:
            xi_norm = (xi - xi.mean()) / std
        xi_clip = np.clip(xi_norm, -3, 3)
        cols.append(np.tanh(xi_clip)); specs.append(("tanh", i, 0.0))
    return np.column_stack(cols), specs
